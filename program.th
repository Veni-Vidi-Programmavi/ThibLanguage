// This is a sample program for the TH language.

// Variable assignments
a = 10
b = 20
message = "The answer is: "

// Perform some calculations
c = (a + b) * 2
result = message + c

// Use the built-in print function to display the output
result.print()

// You can also print other types
isWorking = true
isWorking.print()

"You can print literals directly too!".print()

// --- New function tests ---

// Test the 'length' function on a string
myString = "Hello, World!"
"The length of the string is: ".print()
myString.length().print()

// Test the 'sqrt' function on a number
myNumber = 81
"The square root of 81 is: ".print()
myNumber.sqrt().print()

// --- Quote-less strings and new boolean tests ---

// Test 'yes'/'no' booleans
isReady = yes
isFinished = no
"Is ready? ".print()
isReady.print()
"Is finished? ".print()
isFinished.print()

// Test quote-less string
greeting = hello
(greeting + ", world!").print()